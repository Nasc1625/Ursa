# List of site types
site_types <- c("Main", "Shower", "Water Heater")

# Run ANOVA per site type (Free Chlorine ~ Month)
anova_results <- lapply(site_types, function(site) {
  df <- filter(data_no_july, SiteType == site)
  model <- aov(Free.Chlorine ~ Month, data = df)
  list(
    SiteType = site,
    ANOVA_Summary = summary(model),
    TukeyHSD = TukeyHSD(model)  # optional: pairwise month comparisons
  )
})

names(anova_results) <- site_types

# View results
anova_results


# List of site types
site_types <- c("Main", "Shower", "Water Heater")

# Calculate correlation and linear model per site type
chlorine_temp_results <- lapply(site_types, function(site) {
  df <- filter(data_no_july, SiteType == site)
  
  # Correlation
  corr <- cor(df$Temp..F., df$Free.Chlorine, use = "complete.obs")
  
  # Linear regression
  model <- lm(Free.Chlorine ~ Temp..F., data = df)
  
  list(
    SiteType = site,
    Correlation = corr,
    Model = model,
    Equation = paste0(
      "y = ", round(coef(model)[2], 4), " * x + ", round(coef(model)[1], 4)
    )
  )
})

names(chlorine_temp_results) <- site_types
chlorine_temp_results
